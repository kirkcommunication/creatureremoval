{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#ffffff",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111111",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#f7f7f7",
					"name": "Off White",
					"slug": "accent-5"
				},
				{
					"color": "#555555",
					"name": "Muted",
					"slug": "accent-4"
				},
				{
					"color": "color-mix(in srgb, currentColor 20%, transparent)",
					"name": "Subtle Border",
					"slug": "accent-6"
				}
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1200px"
		},
		"spacing": {
			"defaultSpacingSizes": true,
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		}
	}
}